# Talend TAC monitoring (copy to .env and fill in). Encrypted values are produced
# by: python scripts/encrypt_env.py --password 12345 --input plaintext.json
# NOTE: committed example carries BLANK values only — real users/URLs/passwords
# live solely in the gitignored local .env (guardrail: never commit them).
TAC_USERNAME=
TAC_URL_1=
TAC_PASSWORD_1_ENCRYPTED=
TAC_URL_2=
TAC_PASSWORD_2_ENCRYPTED=
TAC_URL_3=
TAC_PASSWORD_3_ENCRYPTED=
TAC_URL_4=
TAC_PASSWORD_4_ENCRYPTED=
TAC_URL_5=
TAC_PASSWORD_5_ENCRYPTED=
# Master password (decrypts every *_ENCRYPTED value). Default 12345; override it
# HERE or via the SEMAFOR_MASTER_PASSWORD environment variable (env var wins).
SEMAFOR_MASTER_PASSWORD=12345
# SSL verification for live TAC calls: 0 to disable (prototype), 1 to enable
TAC_VERIFY_SSL=0
# Offline simulator toggle: "auto" (live if any server configured, else simulator) | "sim" | "live"
INGESTION_SOURCE=auto
# Default server metadata used by the simulator (name, category, ip).
# Leave blank to use the built-in DEFAULT_SIM_SERVERS (5 demo nodes).
SIM_SERVERS=
# AI diagnostics (optional — rule-based fallback used when blank)
GEMINI_API_KEY=
GEMINI_ENDPOINT=
# SQLite path for the local cache
TALEND_DB_PATH=talend_monitor.db
# WebSocket / API — documentation only (uvicorn is started with the port on the
# CLI; read by Settings for completeness, not used to self-start the server)
API_HOST=127.0.0.1
API_PORT=8000
